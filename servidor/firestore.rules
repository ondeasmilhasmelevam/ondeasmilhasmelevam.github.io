rules_version = '2';
// Cole este texto em Firebase > Firestore Database > Regras > Publicar.
// Só o servidor (conta de serviço) grava. Cada pessoa logada lê apenas a própria assinatura,
// e o conteúdo de assinante (coleção privado) só abre com a assinatura dentro da validade.
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function meuEmail() {
      return request.auth.token.email.lower();
    }
    function assinaturaAtiva() {
      let caminho = /databases/$(database)/documents/assinantes/$(meuEmail());
      return exists(caminho) && get(caminho).data.validoAte > request.time;
    }

    match /assinantes/{email} {
      allow read: if logado() && meuEmail() == email;
      allow write: if false;
    }
    match /pedidos/{nsu} {
      allow read: if logado() && resource.data.email == meuEmail();
      allow write: if false;
    }
    match /privado/{doc} {
      allow read: if logado() && assinaturaAtiva();
      allow write: if false;
    }
    match /{tudo=**} {
      allow read, write: if false;
    }
  }
}
